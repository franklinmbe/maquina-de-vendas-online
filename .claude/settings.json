{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./config/credentials.json)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "ask": [
      "Bash(npm publish:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-CimInstance *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Get-Command *)",
      "PowerShell(claude mcp list)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(GIT_TERMINAL_PROMPT=0 GIT_EDITOR=true git pull --ff-only --no-edit origin main >/dev/null 2>&1 &) ; exit 0",
            "timeout": 10,
            "statusMessage": "Sincronizando com o GitHub em segundo plano..."
          }
        ]
      }
    ]
  }
}
